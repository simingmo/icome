{
  "name": "lego-security-scanner",
  "version": "0.3.0",
  "description": "采用乐高式模块、依赖解析与安全标准映射的可组合源码扫描器",
  "type": "module",
  "bin": {
    "lego-scan": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:package": "vitest run tests/package-smoke.test.ts",
    "scan": "npm run build && node dist/cli.js .",
    "panel": "npm run build && node dist/cli.js --panel",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder",
    "verify": "npm run check && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fast-glob": "^3.3.3",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.5.2",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "license": "MIT",
  "main": "desktop/main.cjs",
  "build": {
    "config": "electron-builder.yml"
  }
}
